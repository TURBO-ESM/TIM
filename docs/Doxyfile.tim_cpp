# Doxygen configuration for TIM's C++ infrastructure layer (tim/cpp).

# Project
PROJECT_NAME           = "TIM"
PROJECT_BRIEF          = "TURBO Infrastructure for MOM - the C++ infrastructure layer for MOM6"
OUTPUT_DIRECTORY       = docs/tim_cpp_build

# Input
INPUT                  = tim/cpp
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.cc *.cxx *.cpp *.c++ *.h *.hpp *.hxx *.h++

# Parsing
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
STRIP_CODE_COMMENTS    = NO

# Warnings
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
WARN_FORMAT            = "$file:$line: $text"

# HTML output
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = LIGHT
DOT_IMAGE_FORMAT       = svg
GENERATE_LATEX         = NO

# Cross-references
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Subdirectories (needed for large projects to avoid filesystem limits)
CREATE_SUBDIRS         = YES
