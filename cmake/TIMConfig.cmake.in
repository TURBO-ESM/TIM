@PACKAGE_INIT@

# TIMConfig.cmake
#
# Valid Find COMPONENTS:
#  * R4         - 32-bit library
#  * R8         - 64-bit library
#
# Imported targets provided:
#  * TIM::tim_r4     - real32 library target (if built with 32BIT=ON)
#  * TIM::tim_r8     - real64 library target (if built with 64BIT=ON)
#  * TIM::tim        - C++ infrastructure layer (always)

include(CMakeFindDependencyMacro)

# Resolve transitive deps BEFORE include(tim-targets.cmake): the exported
# targets reference NetCDF::, MPI::, AMReX::amrex by name, and cmake errors
# out at include() if those imported targets are not yet defined.
find_dependency(MPI COMPONENTS C Fortran)
# Save and restore CMAKE_MODULE_PATH so a pre-existing matching entry is
# preserved (REMOVE_ITEM would drop it).
set(_tim_saved_module_path "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
find_dependency(NetCDF COMPONENTS C Fortran)
set(CMAKE_MODULE_PATH "${_tim_saved_module_path}")
unset(_tim_saved_module_path)
# TIM links against AMReX's Fortran interface; consumers need the same
# component to satisfy transitive symbols at link time.
find_dependency(AMReX COMPONENTS FORTRAN)

if(@OPENMP@)
  find_dependency(OpenMP COMPONENTS C Fortran)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/tim-targets.cmake")

set(TIMVersion "${PACKAGE_VERSION}")
set_and_check(TIM_INSTALL_PREFIX "${PACKAGE_PREFIX_DIR}")

# Component validation — mirrors FMS's fms-config.cmake pattern, with one
# deliberate divergence: FMS also appends to an `FMS_POSSIBLE_COMPONENTS` variable
# that nothing ever reads (the validation below uses _possible_tim_components).
# That dead write is not copied here.
list(APPEND _possible_tim_components "R4" "R8")
foreach(_comp ${_possible_tim_components})
  set(_name_${_comp} ${_comp})
endforeach()

# Default the requested component to the one(s) actually built — prevents
# `find_package(TIM)` from succeeding with no usable target when the
# installed library doesn't include R8.
if(NOT TIM_FIND_COMPONENTS)
  if(@64BIT@)
    list(APPEND _search_tim_components "R8")
  elseif(@32BIT@)
    list(APPEND _search_tim_components "R4")
  endif()
endif()
foreach(_comp ${TIM_FIND_COMPONENTS})
  list(APPEND _search_tim_components ${_comp})
  if(NOT _name_${_comp})
    message(SEND_ERROR
      "TIM: COMPONENT ${_comp} is not a valid component. "
      "Valid components: ${_possible_tim_components}")
  endif()
endforeach()
list(REMOVE_DUPLICATES _search_tim_components)

# ON/OFF reflects whether TIM was built with 32BIT=ON
set(TIM_R4_FOUND 0)
if(@32BIT@)
  set(TIM_R4_FOUND 1)
  get_property(TIM_R4_LIBRARIES TARGET TIM::tim_r4 PROPERTY LOCATION)
endif()

# ON/OFF reflects whether TIM was built with 64BIT=ON
set(TIM_R8_FOUND 0)
if(@64BIT@)
  set(TIM_R8_FOUND 1)
  get_property(TIM_R8_LIBRARIES TARGET TIM::tim_r8 PROPERTY LOCATION)
endif()

check_required_components("TIM")

message(STATUS "Found TIM: \"${TIM_INSTALL_PREFIX}\" (Version: \"${TIMVersion}\")")
message(STATUS "TIM targets:")
foreach(_comp ${_search_tim_components})
  string(TOLOWER "${_comp}" _comp_lower)
  set(_tgt "TIM::tim_${_comp_lower}")
  if(TIM_${_comp}_FOUND)
    message(STATUS "  - ${_tgt} [Lib: ${TIM_${_comp}_LIBRARIES}]")
  else()
    message(STATUS "  - ${_tgt} [COMPONENT ${_comp} NOT FOUND]")
  endif()
endforeach()
